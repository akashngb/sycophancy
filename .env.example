# Copy this file to .env and fill in what you need.
# .env is gitignored. Never commit real keys.

# Hugging Face token. Required only for gated models (Llama, Gemma).
# Create one at https://huggingface.co/settings/tokens
HF_TOKEN=

# Where Hugging Face stores model weights. Keep this inside the repo
# so it is easy to clean up, or point it at a shared cache if you have one.
# HF_HOME=./.hf_cache

# OpenAI and Anthropic API keys. Only needed for the "api" extra.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local servers. Only needed if you use them.
# Ollama default: http://localhost:11434
OLLAMA_HOST=http://localhost:11434
# vLLM, LM Studio, or any OpenAI-compatible server.
OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1

# Override the default results directory. Default is ./results.
# SYCO_RESULTS_DIR=./results

# Override device selection. One of: auto, cuda, mps, cpu.
# Leave unset to let syco pick the best available.
# SYCO_DEVICE=auto
